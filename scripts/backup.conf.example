# /etc/boxe/backup.conf (mode 600): with this file boxe-backup.timer backs boxe up
# every night. Any restic repository works; B2 for example:
RESTIC_REPOSITORY=b2:my-bucket:boxe
B2_ACCOUNT_ID=<application key id, restricted to the bucket>
B2_ACCOUNT_KEY=<application key>
# Keep a copy of this password somewhere else: without it the backups cannot be read.
RESTIC_PASSWORD=<long random password>
# Optional:
# BOXE_BACKUP_KEEP="--keep-daily 7 --keep-weekly 4 --keep-monthly 3"
