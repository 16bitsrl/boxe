# /etc/boxe/boxed.env: settings of this installation (boxed -help lists them all).
BOXED_FLAGS="-sleep-dir /boxe/sleep -sleep-after 30m -domain boxe.example.com -oidc-issuer https://login.example.com -oidc-email-domains example.com"
# New VMs start from the official boxeuntu, which boxed downloads and keeps up
# to date. With an image of your own, add -base boxe/images/<name>-<date>@base
# (and -image-updates= if it is named boxeuntu).
